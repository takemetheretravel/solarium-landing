# .env.example — modelo de variáveis de ambiente (SEM valores reais).
# Copie para .env.local e preencha. NUNCA commitar segredos (repo é público).

# ----------------------------------------------------------------------------
# Provider de pagamento
# ----------------------------------------------------------------------------
# "cielo" (produção atual) ou "braspag" (em migração). Default = "cielo".
PAYMENT_PROVIDER=cielo

# ----------------------------------------------------------------------------
# Braspag (gateway novo — em paralelo à Cielo, atrás da flag acima)
# ----------------------------------------------------------------------------
BRASPAG_ENVIRONMENT=sandbox            # "sandbox" ou "production"
BRASPAG_MERCHANT_ID=
BRASPAG_MERCHANT_KEY=

# 3DS 2.0 (MPI) — credenciais do cliente OAuth do MPI
BRASPAG_3DS_CLIENT_ID=
BRASPAG_3DS_CLIENT_SECRET=             # base64 de 44 chars, termina em "=" — não perder o "=" ao colar

# EstablishmentCode real de sandbox/produção, FORNECIDO PELA BRASPAG.
# NÃO usar o 1006993069 de exemplo da doc em ambiente real — isso causa 401/MPI900.
# Obrigatório: sem esta var, a geração do token 3DS falha com erro explícito.
BRASPAG_3DS_ESTABLISHMENT_CODE=        # ex.: 1006993069 (SÓ exemplo da doc — substituir pelo real)

# Opcionais do 3DS (têm default no código)
BRASPAG_3DS_MERCHANT_NAME=Solarium Mantiqueira
BRASPAG_3DS_MCC=7011                   # 7011 = hospedagem
