# .env.example — modelo de variáveis de ambiente (SEM valores reais).
# Copie para .env.local e preencha. NUNCA commitar segredos (repo é público).

# ----------------------------------------------------------------------------
# Provider de pagamento
# ----------------------------------------------------------------------------
# "cielo" (produção atual) ou "braspag" (em migração). Default = "cielo".
PAYMENT_PROVIDER=cielo

# ----------------------------------------------------------------------------
# Braspag (gateway novo — em paralelo à Cielo, atrás da flag acima)
# ----------------------------------------------------------------------------
BRASPAG_ENVIRONMENT=sandbox            # "sandbox" ou "production"
BRASPAG_MERCHANT_ID=
BRASPAG_MERCHANT_KEY=

# 3DS 2.0 (MPI) — credenciais do cliente OAuth do MPI
BRASPAG_3DS_CLIENT_ID=
BRASPAG_3DS_CLIENT_SECRET=             # base64 de 44 chars, termina em "=" — não perder o "=" ao colar

# EstablishmentCode real de sandbox/produção, FORNECIDO PELA BRASPAG.
# NÃO usar o 1006993069 de exemplo da doc em ambiente real — isso causa 401/MPI900.
# Obrigatório: sem esta var, a geração do token 3DS falha com erro explícito.
BRASPAG_3DS_ESTABLISHMENT_CODE=        # ex.: 1006993069 (SÓ exemplo da doc — substituir pelo real)

# Opcionais do 3DS (têm default no código)
BRASPAG_3DS_MERCHANT_NAME=Solarium Mantiqueira
BRASPAG_3DS_MCC=7011                   # 7011 = hospedagem

# Provider de CARTÃO. Sandbox: default "Simulado". PRODUÇÃO: OBRIGATÓRIO — sem
# esta var em produção a autorização falha com erro explícito (nunca envia
# "Simulado" em produção). Confirmar o valor de produção com a Braspag.
BRASPAG_CARD_PROVIDER=Simulado

# Provider de PIX. Mesma regra: sandbox default "Simulado"; produção obrigatório.
BRASPAG_PIX_PROVIDER=Simulado

# SoftDescriptor na fatura do cliente (cartão). Opcional; default "Solarium Mant".
# Só ASCII (letras/números/espaço), máx 13 chars — o código sanitiza acentos.
BRASPAG_SOFT_DESCRIPTOR=Solarium Mant

# Ordem do antifraude Cybersource (opcionais; defaults no código).
# AuthorizeFirst = autoriza e SÓ então analisa (garante PaymentId p/ rastreio).
# OnSuccess = analisa só se a autorização teve sucesso.
BRASPAG_AF_SEQUENCE=AuthorizeFirst
BRASPAG_AF_SEQUENCE_CRITERIA=OnSuccess
# O log de autorizações (GET /api/payments/braspag/authlog?secret=) reusa o
# mesmo segredo BRASPAG_RECONCILE_SECRET (definido acima).

# Reconciliação de Pix (confirmação por consulta — Pix não tem webhook).
# Duas formas de autorizar GET /api/payments/braspag/pix-reconcile:
#  - Manual/externo: header x-reconcile-secret (ou ?secret=) == BRASPAG_RECONCILE_SECRET.
#  - Vercel Cron (vercel.json, a cada 10min): a Vercel injeta
#    "Authorization: Bearer <CRON_SECRET>" automaticamente quando CRON_SECRET existe.
# Sem NENHUM dos dois configurados, o endpoint responde 503 (nunca fica aberto).
BRASPAG_RECONCILE_SECRET=
CRON_SECRET=

# --- Pacotes V2 (feature/pacotes-v2) ---
# Liga o motor de pacotes, /pacotes, o bloco de extras e a comunicacao D-5 na home.
# Default desligado: sem esta variavel o site renderiza exatamente como hoje.
# So vale apos redeploy.
NEXT_PUBLIC_PACOTES_V2=false

# Preview apenas. Prefixa o hospede com [TESTE], marca o alerta interno e o authlog.
# Nunca liga em producao, mesmo que a variavel exista.
RESERVA_TESTE=false
